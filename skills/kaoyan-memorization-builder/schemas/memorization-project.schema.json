{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-skill.local/schema/memorization-project.schema.json",
  "title": "Kaoyan memorization project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "subject", "sources", "chapters", "review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "scope": {"type": "string"},
    "density": {"enum": ["compact", "standard", "spacious"]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "chapters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chapter"}},
    "transformations": {"type": "array", "items": {"$ref": "#/$defs/transformation"}},
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_order", "type", "label", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "source_order": {"type": "integer", "minimum": 1},
        "type": {"enum": ["pdf", "docx", "image", "user_text"]},
        "label": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string"},
        "pdf_page": {"type": "integer", "minimum": 1},
        "book_page": {"type": ["integer", "string", "null"]},
        "docx_paragraph": {"type": "integer", "minimum": 1},
        "heading": {"type": "string"},
        "image_name": {"type": "string"},
        "text_range": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "statement", "confidence"],
      "properties": {
        "kind": {"enum": ["user_designation", "exam_requirement", "source_emphasis", "historical_question", "retained_study_record", "ai_inference"]},
        "statement": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reference": {"$ref": "#/$defs/locator"}
      }
    },
    "grading": {
      "type": "object", "additionalProperties": false,
      "required": ["importance", "importance_status", "importance_evidence", "personal_weak", "weakness_status", "weakness_evidence"],
      "properties": {
        "importance": {"enum": ["A", "B", "C"]},
        "importance_status": {"enum": ["confirmed", "ai_suggestion"]},
        "importance_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "personal_weak": {"type": "boolean"},
        "weakness_status": {"enum": ["confirmed", "ai_suggestion"]},
        "weakness_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "content", "verbatim", "needs_review"],
      "properties": {
        "origin": {"enum": ["source_text", "ai_summary", "ai_memory_aid", "ai_example", "user_note"]},
        "content": {"type": "string", "minLength": 1},
        "verbatim": {"type": "boolean"},
        "needs_review": {"type": "boolean"},
        "uncertainty": {"type": "string"},
        "references": {"type": "array", "items": {"$ref": "#/$defs/locator"}}
      }
    },
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "title", "origin", "needs_review", "references"],
      "properties": {
        "type": {"enum": ["comparison", "process", "timeline", "relationship", "image"]},
        "title": {"type": "string"},
        "origin": {"enum": ["source_text", "ai_summary", "ai_memory_aid", "ai_example", "user_note"]},
        "needs_review": {"type": "boolean"},
        "references": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "headers": {"type": "array", "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "items": {"type": "array", "items": {"type": "string"}},
        "relations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "relation", "to"], "properties": {"from": {"type": "string"}, "relation": {"type": "string"}, "to": {"type": "string"}}}},
        "path": {"type": "string"},
        "caption": {"type": "string"}
      }
    },
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_order", "title", "grading", "segments"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "source_order": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["definition", "formula", "theorem", "timeline", "vocabulary", "mixed"]},
        "grading": {"$ref": "#/$defs/grading"},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
        "visuals": {"type": "array", "items": {"$ref": "#/$defs/visual"}},
        "recall_lines": {"type": "integer", "minimum": 0, "maximum": 12}
      }
    },
    "chapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_order", "title", "points"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "source_order": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}}
      }
    },
    "transformation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "target", "authorized_by", "authorized_at", "details"],
      "properties": {
        "type": {"enum": ["reorder", "merge", "regroup", "rewrite_definition"]},
        "target": {"type": "string", "pattern": "^(sources|chapters|chapter:[A-Za-z0-9._-]+)$"},
        "authorized_by": {"const": "user"},
        "authorized_at": {"type": "string", "format": "date-time"},
        "details": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["draft", "confirmed"]},
        "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
        "confirmed_by": {"enum": ["user", "not_confirmed"]},
        "notes": {"type": "string"}
      }
    }
  }
}
