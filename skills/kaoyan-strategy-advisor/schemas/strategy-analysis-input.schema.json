{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-skill.local/schema/strategy-analysis-input.schema.json",
  "title": "Kaoyan strategy analysis input",
  "type": "object",
  "additionalProperties": false,
  "required": ["status_snapshot", "user_question", "analysis_summary", "recommendations"],
  "properties": {
    "status_snapshot": {
      "type": "object",
      "required": ["as_of", "summary", "source_refs"],
      "properties": {
        "as_of": {"type": "string", "format": "date"},
        "stage": {"type": ["string", "null"]},
        "summary": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "user_question": {"type": "string", "minLength": 1},
    "analysis_summary": {"type": "string", "minLength": 1},
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recommendation_id", "category", "suggestion", "evidence_refs", "confidence", "confidence_reason", "information_gaps", "costs", "review_window", "review_at", "review_conditions", "fallbacks"],
        "properties": {
          "recommendation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
          "category": {"enum": ["stage_direction", "subject_allocation", "activity_allocation", "progress_risk", "stage_switch", "observation_window", "fallback"]},
          "suggestion": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"enum": ["low", "medium", "high"]},
          "confidence_reason": {"type": "string", "minLength": 1},
          "information_gaps": {"type": "array", "items": {"type": "string"}},
          "costs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "review_window": {"type": "string", "minLength": 1},
          "review_at": {"type": ["string", "null"], "format": "date"},
          "review_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "fallbacks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
